# Copy this file to `.env.capacitor` before running native Capacitor commands.
# These values are consumed by `npm run ios:doctor` and `npm run ios:sync`.
#
# Pinly's native shell loads the live app from CAPACITOR_SERVER_URL.
# The committed `native-shell/` directory is only a fallback page for incomplete
# local setup; it is not a production web build.
#
# Simulator development can point at a local Next.js server:
#   CAPACITOR_SERVER_URL=http://127.0.0.1:3000
# Physical devices must use your LAN IP or a deployed HTTPS URL:
#   CAPACITOR_SERVER_URL=http://192.168.1.x:3000
# Release / staging builds should use the deployed app origin:
#   CAPACITOR_SERVER_URL=https://your-pinly-domain.vercel.app
#
# Native builds still compile the same public web/runtime env that the app uses,
# so keep NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY available
# in `.env` or `.env.local` before syncing the native shell.
#
# Push support is optional for build/sync, but native Firebase delivery will not
# work until you add these local-only files:
#   android/app/google-services.json
#   ios/App/App/GoogleService-Info.plist
CAPACITOR_SERVER_URL=https://your-pinly-domain.vercel.app
